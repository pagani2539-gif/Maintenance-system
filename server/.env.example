NODE_ENV=production
PORT=5221
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# PostgreSQL connection (replaces the old SQLite file path).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://maintenance_app:replace-with-app-role-password@localhost:5432/maintenance_system

# Folder containing pg_dump.exe / pg_restore.exe, used by the backup/restore
# feature (Settings page). The Windows installer does NOT add these to PATH.
# e.g. C:\Program Files\PostgreSQL\18\bin
PG_BIN_DIR=

# Secondary backup copy inside this project. Relative paths are resolved from
# the server folder; use an absolute network/cloud-synced path for real offsite
# protection.
OFFSITE_BACKUP_DIR=database/offsite-backups

# Leave blank for same-origin production use.
# Use a comma-separated list only when browsers access the API from another origin.
CORS_ORIGIN=

# Set to 1 only when you need to temporarily disable startup and scheduled backups.
DISABLE_BACKUP_SCHEDULER=0

# Initial administrator account, seeded only when the users table is empty
# (first boot). If SEED_ADMIN_PASSWORD is left blank a random one-time password
# is generated and printed ONCE to the server log — capture it from there.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
