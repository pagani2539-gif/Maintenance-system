NODE_ENV=production
PORT=5221

# เปิด API ทุก endpoint ให้เรียกได้โดยไม่ต้องใช้ token (ความเสี่ยงสูงมาก)
# ตั้งเป็น 1 เฉพาะกรณีเปิด Public API โดยเฉพาะเท่านั้น
PUBLIC_API_MODE=0

# Temporary read-only GET bypass for a directly connected test client.
# Keep disabled (0) unless you are actively testing from the listed IPs.
READ_ONLY_IP_BYPASS=0
READ_ONLY_IPS=192.168.2.64

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# PostgreSQL connection (replaces the old SQLite file path).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://maintenance_app:replace-with-app-role-password@localhost:5432/maintenance_system

# Test isolation — configure these in server/.env.test. Never point tests at
# the production schema. A dedicated test database is preferred; a dedicated
# schema is required for the local fallback setup.
DATABASE_URL_TEST=postgres://maintenance_app:replace-with-app-role-password@localhost:5432/maintenance_system_test
PG_TEST_SCHEMA=maintenance_test

# Folder containing pg_dump.exe / pg_restore.exe, used by the backup/restore
# feature (Settings page). The Windows installer does NOT add these to PATH.
# e.g. C:\Program Files\PostgreSQL\18\bin
PG_BIN_DIR=

# Secondary backup copy inside this project. Relative paths are resolved from
# the server folder; use an absolute network/cloud-synced path for real offsite
# protection.
OFFSITE_BACKUP_DIR=database/offsite-backups

# PUBLIC_API_MODE=1 จะอนุญาตทุก origin โดยอัตโนมัติ
# ถ้าปิด PUBLIC_API_MODE ให้ใส่ origin ที่อนุญาตคั่นด้วย comma
CORS_ORIGIN=*

# Set to 1 only when you need to temporarily disable startup and scheduled backups.
DISABLE_BACKUP_SCHEDULER=0

# Initial administrator account, seeded only when the users table is empty
# (first boot). If SEED_ADMIN_PASSWORD is left blank a random one-time password
# is generated and printed ONCE to the server log — capture it from there.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
